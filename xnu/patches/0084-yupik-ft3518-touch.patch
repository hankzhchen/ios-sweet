+/* ---- GPI DMA (GSI mode) ---- */
+
+static uint32_t
+gpi_rd(uint32_t off)
+{
+	return touch_rd(st.gpi, off - GPI_EE); /* Linux: ee_base = regs - ee_offset */
+}
+
+static void
+gpi_wr(uint32_t off, uint32_t val)
+{
+	touch_wr(st.gpi, off - GPI_EE, val);
+}
+
+static void
+gpi_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(st.dma_pa + off), len, TRUE);
+}
+
+/* Poll a context's CHSTATE (bits 23:20); commands finish in microseconds. */
+static bool
+gpi_wait_state(uint32_t ctx, uint32_t want)
+{
+	for (unsigned i = 0; i < 100000; ++i) {
+		if (((gpi_rd(ctx + CTX_CONFIG) >> 20) & 0xfu) == want) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET TOUCH: gpi ctx %#x state %#x, want %#x; err-log %#x glob %#x\n", ctx,
+	    (gpi_rd(ctx + CTX_CONFIG) >> 20) & 0xfu, want,
+	    gpi_rd(GPII_REG(0x23200u)), gpi_rd(GPII_REG(0x23100u)));
+	return false;
+}
+
+static bool
+gpi_ch_cmd(uint32_t op, uint32_t chid, uint32_t want)
+{
+	gpi_wr(GPII_CH_CMD, (op << 24) | chid);
+	return gpi_wait_state(GPII_CH_CTX(chid), want);
+}
+
+static void
+gpi_ring_db(uint32_t chid)
+{
+	gpi_wr(GPII_CH_DB(chid), (uint32_t)(st.dma_pa + GPI_OFF_CH(chid) + st.ch_wp[chid]));
+}
+
+static void
+gpi_put_tre(uint32_t chid, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	uint32_t off = GPI_OFF_CH(chid) + st.ch_wp[chid];
+	volatile uint32_t *tre = (volatile uint32_t *)(st.dma + off);
+	tre[0] = d0;
+	tre[1] = d1;
+	tre[2] = d2;
+	tre[3] = d3;
+	gpi_sync(off, GPI_TRE);
+	st.ch_wp[chid] = (st.ch_wp[chid] + GPI_TRE) % GPI_CH_LEN;
+}
+
+/*
+ * Consume events until a transfer completion on chid. Returns 0 on EOT/EOB/
+ * success, EIO on an error completion or notification, ETIMEDOUT otherwise.
+ */
 static int
+gpi_wait_xfer(uint32_t chid)
+{
+	int result = ETIMEDOUT;
+	for (unsigned i = 0; i < 100000 && result == ETIMEDOUT; ++i) {
+		uint32_t hw = gpi_rd(GPII_EV_CTX + CTX_RP_LO) - (uint32_t)(st.dma_pa + GPI_OFF_EV);
+		if (hw >= GPI_EV_LEN || hw == st.ev_rp) {
+			delay(1);
+			continue;
+		}
+		while (st.ev_rp != hw) {
+			uint32_t off = GPI_OFF_EV + st.ev_rp;
+			gpi_sync(off, GPI_TRE);
+			volatile uint32_t *ev = (volatile uint32_t *)(st.dma + off);
+			uint32_t d2 = ev[2], d3 = ev[3];
+			uint32_t type = (d3 >> 16) & 0xffu, ev_ch = d3 >> 24, code = d2 >> 24;
+			if (type == 0x22u && ev_ch == chid && result == ETIMEDOUT) {
+				result = (code == 1u || code == 2u || code == 4u) ? 0 : EIO;
+			} else if (type == 0x31u || (type == 0x22u && code == 16u)) {
+				result = EIO; /* QUP notification (e.g. NACK) or unexpected error */
+			}
+			if (result == EIO || st.probing) {
+				printf("SWEET TOUCH: gpi ev %08x %08x %08x %08x\n", ev[0], ev[1], d2, d3);
+			}
+			/* Recycle: hand the slot back to the engine. */
+			st.ev_rp = (st.ev_rp + GPI_TRE) % GPI_EV_LEN;
+			gpi_wr(GPII_EV_DB, (uint32_t)(st.dma_pa + GPI_OFF_EV +
+			    (st.ev_rp + GPI_EV_LEN - GPI_TRE) % GPI_EV_LEN));
+		}
+	}
+	return result;
+}
