+/* Register read over GPI: pointer write (stretch), then read; Linux geni_i2c_gpi_xfer. */
+static int
+gpi_i2c_read(uint8_t addr, const uint8_t *ptr, unsigned nptr, uint8_t *buf, unsigned len)
+{
+	if (st.dead || !nptr || nptr > 2 || !len || len > 256) {
+		return EIO;
+	}
+	volatile uint8_t *tx = (volatile uint8_t *)(st.dma + GPI_OFF_TXBUF);
+	for (unsigned i = 0; i < nptr; ++i) {
+		tx[i] = ptr[i];
+	}
+	gpi_sync(GPI_OFF_TXBUF, 64);
+	if (!st.gsi_configured) {
+		/* 100 kHz from the 19.2 MHz SE clock: t_low 11, t_high 10, t_cycle 26, div 7. */
+		gpi_put_tre(0, 11u | (10u << 8) | (26u << 16) | (1u << 24) | (1u << 25), 0, 7u,
+		    (TRE_CONFIG0 << 16) | TRE_CHAIN);
+		st.gsi_configured = true;
+	}
+	gpi_put_tre(0, I2C_OP_WRITE | ((uint32_t)addr << 8) | (1u << 26), 0, nptr,
+	    (TRE_GO << 16) | TRE_CHAIN);
+	gpi_put_tre(0, (uint32_t)(st.dma_pa + GPI_OFF_TXBUF), (uint32_t)((st.dma_pa + GPI_OFF_TXBUF) >> 32),
+	    nptr, (TRE_DMA << 16) | TRE_IEOT);
+	gpi_ring_db(0);
+	int err = gpi_wait_xfer(0);
+	if (err) {
+		goto fail;
+	}
+	gpi_sync(GPI_OFF_RXBUF, 256);
+	gpi_put_tre(1, (uint32_t)(st.dma_pa + GPI_OFF_RXBUF), (uint32_t)((st.dma_pa + GPI_OFF_RXBUF) >> 32),
+	    len, (TRE_DMA << 16) | TRE_IEOT);
