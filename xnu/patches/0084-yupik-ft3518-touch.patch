+/* Bring-up checkpoint: printed, then a pause so the persistent log (ufslogsecs) has it. */
+static void
+gpi_step(unsigned n, const char *what)
+{
+	printf("SWEET TOUCH: gpi step %u: %s\n", n, what);
+	touch_wait(1500);
+}
+
+static bool
+gpi_init(void)
+{
+	gpi_step(1, "map GPI block, allocate rings");
+	st.gpi = ml_io_map(GPI_PA, GPI_SIZE);
+	if (!st.gpi || kmem_alloc_contig(kernel_map, &st.dma, GPI_DMA_SIZE, GPI_DMA_SIZE - 1, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET TOUCH: gpi map/alloc failed\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)st.dma);
+	if (!pn) {
+		return false;
+	}
+	st.dma_pa = ptoa_64(pn);
+	gpi_step(2, "read gpii channel/event contexts");
+	uint32_t ch0 = gpi_rd(GPII_CH_CTX(0)), ch1 = gpi_rd(GPII_CH_CTX(1)), ev = gpi_rd(GPII_EV_CTX);
+	printf("SWEET TOUCH: gpi gpii%u ch0=%#x ch1=%#x ev=%#x dma=%#llx\n", GPI_GPII, ch0, ch1, ev,
+	    st.dma_pa);
+	if (((ch0 | ch1 | ev) >> 20) & 0xfu) {
+		printf("SWEET TOUCH: gpii%u already in use; not touching it\n", GPI_GPII);
+		return false;
+	}
+	gpi_step(3, "SE to GSI mode");
+	gpi_se_select();
+	gpi_sync(0, GPI_DMA_SIZE);
+	gpi_step(4, "gpii interrupt config");
+
+	/* Interrupt configuration as Linux gpi_config_interrupts (not routed: polled). */
+	gpi_wr(GPII_REG(0x23088u), 0x4fu);
+	gpi_wr(GPII_REG(0x230b8u), 1u);
+	gpi_wr(GPII_REG(0x23098u), 3u);
+	gpi_wr(GPII_REG(0x2309cu), 1u);
+	gpi_wr(GPII_REG(0x23108u), 0xfu);
+	gpi_wr(GPII_REG(0x23120u), 0xfu);
+	gpi_wr(GPII_REG(0x23188u), 0);
+	gpi_wr(GPII_REG(0x2318cu), 0);
+	gpi_wr(GPII_REG(0x23400u), 0);
+	gpi_wr(GPII_REG(0x23404u), 0);
+	gpi_wr(GPII_REG(0x23180u), 1u);
+	gpi_wr(GPII_REG(0x23200u), 0);
+
+	/* Event ring: allocate, program, give every element to the engine. */
+	gpi_step(5, "event ring allocate");
+	gpi_wr(GPII_EV_CMD, 0u << 24);
+	if (!gpi_wait_state(GPII_EV_CTX, 1u)) {
+		return false;
+	}
+	uint64_t ev_pa = st.dma_pa + GPI_OFF_EV;
+	gpi_wr(GPII_EV_CTX + CTX_CONFIG, (GPI_TRE << 24) | (1u << 16) | 2u);
+	gpi_wr(GPII_EV_CTX + CTX_LEN, GPI_EV_LEN);
+	gpi_wr(GPII_EV_CTX + CTX_BASE_LO, (uint32_t)ev_pa);
+	gpi_wr(GPII_EV_CTX + CTX_BASE_HI, (uint32_t)(ev_pa >> 32));
+	gpi_wr(GPII_EV_DB + 4u, (uint32_t)(ev_pa >> 32));
+	gpi_wr(GPII_EV_CTX + CTX_INT_MOD, 0);
+	gpi_wr(GPII_EV_CTX + CTX_MSI_LO, 0);
+	gpi_wr(GPII_EV_CTX + CTX_MSI_HI, 0);
+	gpi_wr(GPII_EV_CTX + CTX_RPU_LO, 0);
+	gpi_wr(GPII_EV_CTX + CTX_RPU_HI, 0);
+	st.ev_rp = 0;
+	gpi_wr(GPII_EV_DB, (uint32_t)(ev_pa + GPI_EV_LEN - GPI_TRE));
+
+	/* TX (chid 0, direction out) and RX (chid 1, in) channels. */
+	gpi_step(6, "channel allocate");
+	for (uint32_t chid = 0; chid < 2; ++chid) {
+		if (!gpi_ch_cmd(0u, chid, 1u)) {
+			return false;
+		}
+		uint64_t pa = st.dma_pa + GPI_OFF_CH(chid);
+		gpi_wr(GPII_CH_CTX(chid) + CTX_CONFIG, (GPI_TRE << 24) | ((chid ? 0u : 1u) << 3) | 2u);
+		gpi_wr(GPII_CH_CTX(chid) + CTX_LEN, GPI_CH_LEN);
+		gpi_wr(GPII_CH_CTX(chid) + CTX_BASE_LO, (uint32_t)pa);
+		gpi_wr(GPII_CH_CTX(chid) + CTX_BASE_HI, (uint32_t)(pa >> 32));
+		gpi_wr(GPII_CH_DB(chid) + 4u, (uint32_t)(pa >> 32));
+		gpi_wr(GPII_CH_SCRATCH(chid, 0), ((chid ^ 1u) << 16) | (GPI_PROTO_I2C << 4) | GPI_SEID);
+		gpi_wr(GPII_CH_SCRATCH(chid, 1), 0);
+		gpi_wr(GPII_CH_SCRATCH(chid, 2), 0);
+		gpi_wr(GPII_CH_SCRATCH(chid, 3), 0);
+		gpi_wr(GPII_CH_QOS(chid), 1);
+		st.ch_wp[chid] = 0;
+	}
+	gpi_step(7, "channel start");
+	for (uint32_t chid = 0; chid < 2; ++chid) {
+		if (!gpi_ch_cmd(1u, chid, 2u)) {
+			return false;
+		}
+	}
+	printf("SWEET TOUCH: gpi gpii%u started: ch0=%#x ch1=%#x ev=%#x\n", GPI_GPII,
+	    gpi_rd(GPII_CH_CTX(0)), gpi_rd(GPII_CH_CTX(1)), gpi_rd(GPII_EV_CTX));
+	return true;
+}
